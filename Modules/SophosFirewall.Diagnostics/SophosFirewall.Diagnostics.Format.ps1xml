<?xml version="1.0" encoding="utf-8"?>
<!--
    Default table/list views for Get-SfosLog. One pair of views (table + list, selected with
    -List) per log viewer category, plus a Sfos.Log fallback pair for records that carry no
    matching type name. For sixteen of the seventeen categories, the column set and order
    reproduce the web admin console's own Log Viewer screen, read from the appliance's
    LogViewerConf.js (LogViewer.moduleJSON: the ordered column list and label overrides per
    category) and resolved through common.js (the Language.* string table); every column and
    order was cross-checked against the console screenshots supplied by the operator. The
    Firewall category is the one exception and keeps this module's own nine-column choice from
    before that comparison - see this module's own findings file. The console's "Live PCAP" entry is an
    action button, not a data field (wire name packetcapturefilter), and is omitted everywhere.
    Wide categories (Firewall, SSL/TLS inspection) wrap in a narrow console; use -List or
    Select-Object there. See this module's own findings file and Get-SfosLog's own help.
-->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Sfos.Log.Firewall</Name>
      <ViewSelectedBy>
        <TypeName>Sfos.Log.Firewall</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Datetime</Label><Width>19</Width></TableColumnHeader>
          <TableColumnHeader><Label>Component</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Subtype</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>In</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>src_ip</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>SPort</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Out</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>dst_ip</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>DPort</Label><Width>6</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Datetime</PropertyName><FormatString>{0:yyyy-MM-dd HH:mm:ss}</FormatString></TableColumnItem>
              <TableColumnItem><PropertyName>log_component</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>log_subtype</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>in_interface</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>src_ip</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>src_port</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>out_interface</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>dst_ip</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>dst_port</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Sfos.Log.Firewall.List</Name>
      <ViewSelectedBy>
        <TypeName>Sfos.Log.Firewall.List</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Datetime</PropertyName><FormatString>{0:yyyy-MM-dd HH:mm:ss}</FormatString></ListItem>
              <ListItem><PropertyName>log_component</PropertyName></ListItem>
              <ListItem><PropertyName>log_subtype</PropertyName></ListItem>
              <ListItem><PropertyName>in_interface</PropertyName></ListItem>
              <ListItem><PropertyName>src_ip</PropertyName></ListItem>
              <ListItem><PropertyName>src_port</PropertyName></ListItem>
              <ListItem><PropertyName>out_interface</PropertyName></ListItem>
              <ListItem><PropertyName>dst_ip</PropertyName></ListItem>
              <ListItem><PropertyName>dst_port</PropertyName></ListItem>
