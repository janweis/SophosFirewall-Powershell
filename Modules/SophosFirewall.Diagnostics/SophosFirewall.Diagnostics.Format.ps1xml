        <TypeName>Sfos.Log.List</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Datetime</PropertyName><FormatString>{0:yyyy-MM-dd HH:mm:ss}</FormatString></ListItem>
              <ListItem><PropertyName>log_type</PropertyName></ListItem>
              <ListItem><PropertyName>log_component</PropertyName></ListItem>
              <ListItem><PropertyName>log_subtype</PropertyName></ListItem>
              <ListItem><PropertyName>status</PropertyName></ListItem>
              <ListItem><PropertyName>message</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
